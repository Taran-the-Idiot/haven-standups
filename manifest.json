{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Haven Standups",
    "description": "Daily standup reminders and thread follow-ups for Haven events",
    "background_color": "#1F2937"
  },
  "features": {
    "bot_user": {
      "display_name": "Haven Standups",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/activate-standup",
        "description": "Activate the standup bot in this channel and set the timezone.",
        "usage_hint": "<timezone(eg: Australia/Sydney)>",
        "should_escape": false
      },
      {
        "command": "/reset-standup",
        "description": "Reset the standup bot in this channel.",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "channels:read",
        "groups:read",
        "im:read",
        "im:history",
        "mpim:read",
        "mpim:history",
        "channels:history",
        "groups:history",
        "chat:write.public",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}

